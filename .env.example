# ==============================================================================
# AI POWERED RETAIL CONNECT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development. Never commit secrets.

# --- AI Studio / Runtime ---
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# --- Gemini API (Server-Side Only) ---
# Configured in AI Studio Secrets or local .env
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- FastAPI Backend Service ---
API_HOST="0.0.0.0"
API_PORT=8000
API_ENV="development"
JWT_SECRET="change-me-in-production-use-64-char-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL / Supabase Database ---
# Option A: Supabase PostgreSQL connection string (Pooler or Direct)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/retail_connect"
# Option B: Local SQLite runtime path (used by integrated Node preview server)
SQLITE_DB_PATH="./database/retail_connect.sqlite"

# --- Supabase Integration (Backend & Public Client) ---
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend (VITE_*) variables!
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="kirana-product-images"

# --- Frontend Public Env Vars (Vite) ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"

# --- Computer Vision Microservice ---
VISION_SERVICE_URL="http://localhost:8001"
VISION_DETECTOR_DEFAULT="rt_detr"
VISION_EMBEDDING_MODEL="dinov2_vits14"
VISION_OCR_ENGINE="easyocr"
VISION_UNKNOWN_SIMILARITY_THRESHOLD="0.58"

# --- Deterministic Synthetic Data Seed ---
SYNTHETIC_SEED=42
